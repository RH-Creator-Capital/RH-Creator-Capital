# Supabase Database URL (PostgreSQL Connection String)
# Example: postgresql://postgres.xxxx:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=""

# Robinhood Chain RPC
# Set your Robinhood Chain RPC URL
RH_CHAIN_RPC_URL=""

# (Optional) If you use local tunnel for webhooks:
# NGROK_AUTHTOKEN=""

# Twitter / X OAuth API Credentials
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_CALLBACK_URL="http://localhost:8080/api/oauth/twitter/callback"

# JWT Secret for OAuth Tokens
JWT_SECRET="super_secret_dev_key"
